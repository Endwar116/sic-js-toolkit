{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Endwar116/SIC-Semantic-Infinite-Context/sic-js-schema-v2.0.json",
  "title": "SIC-JS v2.0 Toolkit Fork Schema",
  "description": "Toolkit fork of SIC-JS v2.0. upstream_type is project-local extension, NOT canonical. DO NOT use this for canonical validation.",
  "type": "object",
  "required": [
    "sic_version",
    "round",
    "entity",
    "state",
    "relation",
    "event",
    "intent"
  ],
  "additionalProperties": false,
  "properties": {
    "sic_version": {
      "type": "string",
      "const": "2.0",
      "description": "SIC-JS schema version. Must be '2.0'."
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "description": "Sequence number for 3D serialization index. Must be continuous even when event=null."
    },
    "entity": {
      "type": "object",
      "description": "Static Triad — Identity anchor. What is this?",
      "required": [
        "name",
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Instance name (e.g. '安安的助理')"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Underlying model (Claude / GPT / Gemini)"
        },
        "origin": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where this instance originated from"
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Creation timestamp (ISO 8601)"
        }
      }
    },
    "state": {
      "type": "object",
      "description": "Static Triad — Current snapshot. What is happening now?",
      "required": [
        "context",
        "current_action"
      ],
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1,
          "description": "Current situational context"
        },
        "current_action": {
          "type": "string",
          "minLength": 1,
          "description": "What is being done right now"
        },
        "pending": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Unfinished items"
        },
        "tone": {
          "type": [
            "string",
            "null"
          ],
          "description": "Current tone or operational mode"
        }
      }
    },
    "relation": {
      "type": "object",
      "description": "Static Triad — Relationship anchor. Connected to what?",
      "required": [
        "user",
        "upstream_type"
      ],
      "additionalProperties": false,
      "properties": {
        "user": {
          "type": "string",
          "minLength": 1,
          "description": "Who is the conversation partner"
        },
        "anchor_memory": {
          "type": [
            "string",
            "null"
          ],
          "description": "Most important associated memory"
        },
        "linked_entities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "Other related entities"
        },
        "upstream": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Format depends on upstream_type. cryptographic: 16 hex; file: semantic label; none: null."
        },
        "upstream_type": {
          "type": "string",
          "enum": [
            "none",
            "cryptographic",
            "file"
          ],
          "description": "TOOLKIT PROJECT-LOCAL EXTENSION. NOT SIC-JS v2.0 canonical."
        }
      }
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "description": "Dynamic Dyad — Event record. What happened?",
          "required": [
            "timestamp",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "When it happened (ISO 8601)"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "What happened"
            },
            "trigger": {
              "type": [
                "string",
                "null"
              ],
              "description": "What triggered it (free text)"
            }
          }
        },
        {
          "type": "null",
          "description": "Confirmed no event this round (sensor on, nothing detected)"
        }
      ]
    },
    "intent": {
      "oneOf": [
        {
          "type": "object",
          "description": "Dynamic Dyad — Intent anchor. For what purpose?",
          "required": [
            "user_intent"
          ],
          "additionalProperties": false,
          "properties": {
            "user_intent": {
              "type": "string",
              "minLength": 1,
              "description": "What the user wants"
            },
            "system_intent": {
              "type": [
                "string",
                "null"
              ],
              "description": "What the system is doing"
            },
            "core_question": {
              "type": [
                "string",
                "null"
              ],
              "description": "Underlying core question"
            }
          }
        },
        {
          "type": "null",
          "description": "Confirmed no intent this round"
        }
      ]
    }
  }
}